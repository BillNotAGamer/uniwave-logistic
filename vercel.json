{
  "rewrites": [
    {
      "source": "/vi/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/en/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/(vi|en)/(languages|image|js|css)/:path*",
      "destination": "/:1/:path*"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/languages/(.*)\\.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ],
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "uniwave-logistics.com" }],
      "destination": "https://www.uniwave-logistics.com/:path*",
      "permanent": true
    }
  ]
}