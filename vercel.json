{
  "rewrites": [
    {
      "source": "/vi",
      "destination": "/index.html"
    },
    {
      "source": "/en",
      "destination": "/index.html"
    },
    {
      "source": "/vi/introduce",
      "destination": "/introduce.html"
    },
    {
      "source": "/en/introduce",
      "destination": "/introduce.html"
    },
    {
      "source": "/vi/support",
      "destination": "/support.html"
    },
    {
      "source": "/en/support",
      "destination": "/support.html"
    },
    {
      "source": "/vi/international",
      "destination": "/international.html"
    },
    {
      "source": "/en/international",
      "destination": "/international.html"
    },
    {
      "source": "/vi/languages/:path*",
      "destination": "/languages/:path*"
    },
    {
      "source": "/en/languages/:path*",
      "destination": "/languages/:path*"
    },
    {
      "source": "/vi/image/:path*",
      "destination": "/image/:path*"
    },
    {
      "source": "/en/image/:path*",
      "destination": "/image/:path*"
    },
    {
      "source": "/vi/js/:path*",
      "destination": "js/:path*"
    },
    {
      "source": "/en/js/:path*",
      "destination": "js/:path*"
    },
    {
      "source": "/vi/css/:path*",
      "destination": "css/:path*"
    },
    {
      "source": "/en/css/:path*",
      "destination": "css/:path*"
    },
    {
      "source": "/vi/css/:path*",
      "destination": "uni-content/css/:path*"
    },
    {
      "source": "/en/css/:path*",
      "destination": "uni-content/css/:path*"
    },
    {
      "source": "/vi/uni-content/:path*",
      "destination": "uni-content/:path*"
    },
    {
      "source": "/en/uni-content/:path*",
      "destination": "uni-content/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/vi",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/languages/(.*)\\.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "cleanUrls": false,
  "trailingSlash": false
}
