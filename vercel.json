{
  "rewrites": [
    {
      "source": "/vi",
      "destination": "/index.html"
    },
    {
      "source": "/en",
      "destination": "/index.html"
    },
    {
      "source": "/vi/introduce",
      "destination": "/introduce.html"
    },
    {
      "source": "/en/introduce",
      "destination": "/introduce.html"
    },
    {
      "source": "/vi/services",
      "destination": "/services.html"
    },
    {
      "source": "/en/services",
      "destination": "/services.html"
    },
    {
      "source": "/vi/domestic-delivery-service",
      "destination": "/domestic-delivery-service.html"
    },
    {
      "source": "/en/domestic-delivery-service",
      "destination": "/domestic-delivery-service.html"
    },
    {
      "source": "/vi/price-check",
      "destination": "/price-check.html"
    },
    {
      "source": "/en/price-check",
      "destination": "/price-check.html"
    },
    {
      "source": "/vi/tracking-shipment",
      "destination": "/tracking-shipment.html"
    },
    {
      "source": "/en/tracking-shipment",
      "destination": "/tracking-shipment.html"
    },
    {
      "source": "/vi/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/en/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/vi/authentication",
      "destination": "/authentication.html"
    },
    {
      "source": "/en/authentication",
      "destination": "/authentication.html"
    },
    {
      "source": "/user-dashboard",
      "destination": "/user-dashboard.html"
    },
    {
      "source": "/vi/international",
      "destination": "/international.html"
    },
    {
      "source": "/en/international",
      "destination": "/international.html"
    },
    {
      "source": "/vi/languages/:path*",
      "destination": "/languages/:path*"
    },
    {
      "source": "/en/languages/:path*",
      "destination": "/languages/:path*"
    },
    {
      "source": "/vi/image/:path*",
      "destination": "/image/:path*"
    },
    {
      "source": "/en/image/:path*",
      "destination": "/image/:path*"
    },
    {
      "source": "/vi/js/:path*",
      "destination": "js/:path*"
    },
    {
      "source": "/en/js/:path*",
      "destination": "js/:path*"
    },
    {
      "source": "/vi/css/:path*",
      "destination": "css/:path*"
    },
    {
      "source": "/en/css/:path*",
      "destination": "css/:path*"
    },
    {
      "source": "/vi/css/:path*",
      "destination": "uni-content/css/:path*"
    },
    {
      "source": "/en/css/:path*",
      "destination": "uni-content/css/:path*"
    }
    
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/en",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/languages/(.*)\\.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "cleanUrls": false,
  "trailingSlash": false
}
