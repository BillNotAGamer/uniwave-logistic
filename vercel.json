{
  "rewrites": [
    {
      "source": "/vi",
      "destination": "/index.html"
    },
    {
      "source": "/en",
      "destination": "/index.html"
    },
    {
      "source": "/vi/:path",
      "destination": "/:path.html"
    },
    {
      "source": "/en/:path",
      "destination": "/:path.html"
    },
    {
      "source": "/(vi|en)/(languages|image|js|css|uni-content)/:path*",
      "destination": "/:1/:path*"
    },
    {
      "source": "/:path",
      "destination": "/:path.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/vi",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/languages/(.*)\\.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ],
  "cleanUrls": false,
  "trailingSlash": false
}